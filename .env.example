# VerityAI environment configuration.
# Copy to .env and adjust. Every value here is OPTIONAL - the core pipeline
# (Wikipedia/MediaWiki + Wikidata + OpenAlex retrieval, BGE + BM25 + RRF,
# DeBERTa NLI) runs without any key and without any paid service.

# --- Server ---
VERITY_HOST=0.0.0.0
VERITY_PORT=8000
# Comma-separated list of allowed browser origins. "*" for the public demo.
VERITY_CORS_ORIGINS=*

# --- Compute ---
# cpu (default) or cuda. CPU is the default target and matches the free host.
VERITY_DEVICE=cpu
# Number of CPU threads torch may use. Empty = library default.
VERITY_TORCH_THREADS=

# --- Model cache ---
# Point this at a drive with space; the models total ~1 GB.
# Windows example: D:\hf-cache
HF_HOME=

# Optional: where passage embeddings are cached on disk. Defaults to a temp dir.
VERITY_EMBED_CACHE_DIR=

# --- Optional evidence sources ---
# Enables the Google Fact Check Tools (ClaimReview) adapter when set.
# Free with a Google Cloud API key. Left empty, the adapter is disabled and
# reported as "skipped" in the sources-queried list.
FACTCHECK_API_KEY=
# Contact e-mail for the OpenAlex polite pool (recommended, not required).
OPENALEX_MAILTO=

# --- Retrieval / analysis tuning (defaults shown) ---
VERITY_TAU_NLI=0.5
VERITY_TAU_NLI_SINGLE_SOURCE=0.75
VERITY_TOP_K_RETRIEVAL=10
VERITY_TOP_K_NLI=6
VERITY_MAX_CLAIMS=5
VERITY_USE_RERANKER=false
