# VerityAI environment configuration. Every value is optional.
# Core retrieval + NLI works without paid services or API keys.

# --- Server ---
VERITY_HOST=0.0.0.0
VERITY_PORT=8000
VERITY_CORS_ORIGINS=*

# --- Request protection ---
# Per socket-client IP, per process. Defaults: 10 analysis requests / 60 seconds.
VERITY_RATE_LIMIT_REQUESTS=10
VERITY_RATE_LIMIT_WINDOW_S=60
# Maximum JSON body for analysis endpoints (1 MB).
VERITY_MAX_REQUEST_BYTES=1000000
VERITY_REQUEST_BODY_TIMEOUT_S=5
VERITY_ANALYSIS_TIMEOUT_S=60

# --- Compute ---
VERITY_DEVICE=cpu
VERITY_TORCH_THREADS=

# --- Model cache ---
# Windows example: D:\hf-cache
HF_HOME=
VERITY_EMBED_CACHE_DIR=

# --- Optional evidence sources ---
# Google Fact Check Tools is disabled when this is empty.
FACTCHECK_API_KEY=
OPENALEX_MAILTO=
# Optional, experimental keyless news-style source (off by default; value not yet measured).
VERITY_ENABLE_WIKINEWS=false

# --- Retrieval / analysis tuning ---
VERITY_RETRIEVAL_MODE=dense
VERITY_TAU_NLI=0.5
VERITY_TAU_NLI_SINGLE_SOURCE=0.75
VERITY_TOP_K_RETRIEVAL=10
VERITY_TOP_K_NLI=6
VERITY_MAX_CLAIMS=5
VERITY_USE_RERANKER=false
